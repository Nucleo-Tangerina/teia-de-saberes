# Contact form (app/contato/actions.ts) sends through Resend
RESEND_API_KEY=
# Team inbox(es) that receive requests, comma-separated
CONTACT_TO=
# Verified sender, e.g. "Site Teia de Saberes <site@teiadesaberes.com.br>"
CONTACT_FROM=
# Client approval mode (app/aprovar, issue #48). Set ONLY on the test site; the secret link is /aprovar?c=<this value>
APROVACAO_TOKEN=
# Approval mode storage (app/aprovacao/actions.ts, issue #50): fine-grained token, this repository only, Issues read and write
GITHUB_TOKEN=
# Optional, defaults to Nucleo-Tangerina/teia-de-saberes
GITHUB_REPO=
